<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标底：与「白猫 + 黄笔记本」母题同一套靛蓝渐变（左上偏亮、右下偏深）。
     颜色必须和 tools/make_icon_easy.py 的 BG_LIGHT / BG_DARK 一致，
     否则圆形/水滴遮罩外溢时四角会露出另一套底色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF6C7AEA"
        android:endColor="#FF3844B0" />
</shape>
